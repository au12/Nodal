	<string>io.github.au12.nodal</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Nodal</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
